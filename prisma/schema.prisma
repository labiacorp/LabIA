generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  IDEA
  IN_PROGRESS
  REVIEW
  APPROVED
  REJECTED
}

enum StepKind {
  SCRIPT
  IMAGE
  VIDEO
  VOICE
  ASSEMBLY
}

enum StepStatus {
  PENDING
  QUOTED
  RUNNING
  DONE
  FAILED
  APPROVED
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
}

enum LedgerReason {
  TOPUP
  SPEND
  REFUND
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  image       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  influencers Influencer[]
  assets      Asset[]
  ledger      LedgerEntry[]

  @@map("users")
}

// The recurring character: face reference, niche and tone. Every Content belongs to one.
model Influencer {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  niche       String
  tone        String
  persona     String    @default("")
  faceAssetId String?   @map("face_asset_id")
  contents    Content[]
  assets      Asset[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("influencers")
}

// One piece of content: idea -> script -> image -> video -> (voice) -> assembly.
model Content {
  id           String        @id @default(cuid())
  influencerId String        @map("influencer_id")
  influencer   Influencer    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  title        String
  idea         String        @default("")
  aspectRatio  String        @default("9:16") @map("aspect_ratio")
  status       ContentStatus @default(IDEA)
  steps        Step[]
  assets       Asset[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([influencerId, updatedAt])
  @@map("contents")
}

// One paid or free action in the pipeline. Cost is quoted before and recorded after.
model Step {
  id               String     @id @default(cuid())
  contentId        String     @map("content_id")
  content          Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  kind             StepKind
  position         Int
  status           StepStatus @default(PENDING)
  model            String?
  input            Json       @default("{}")
  falRequestId     String?    @unique @map("fal_request_id")
  estimatedCostBrl Decimal?   @map("estimated_cost_brl") @db.Decimal(12, 4)
  actualCostBrl    Decimal?   @map("actual_cost_brl") @db.Decimal(12, 4)
  error            String?
  assets           Asset[]
  ledger           LedgerEntry[]
  createdAt        DateTime   @default(now()) @map("created_at")
  startedAt        DateTime?  @map("started_at")
  completedAt      DateTime?  @map("completed_at")

  @@unique([contentId, position])
  @@map("steps")
}

model Asset {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencerId String?     @map("influencer_id")
  influencer   Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  contentId    String?     @map("content_id")
  content      Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)
  stepId       String?     @map("step_id")
  step         Step?       @relation(fields: [stepId], references: [id], onDelete: SetNull)
  kind         AssetKind
  url          String
  width        Int?
  height       Int?
  durationSec  Float?      @map("duration_sec")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([influencerId, createdAt])
  @@map("assets")
}

// Balance = sum(delta_brl). Top-ups are manual for now; spends are written when a step is confirmed.
model LedgerEntry {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaBrl  Decimal      @map("delta_brl") @db.Decimal(12, 4)
  reason    LedgerReason
  stepId    String?      @map("step_id")
  step      Step?        @relation(fields: [stepId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ledger_entries")
}
