generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  IDEA
  IN_PROGRESS
  REVIEW
  APPROVED
  REJECTED
}

enum StepKind {
  CHARACTER
  SCRIPT
  IMAGE
  VIDEO
  VOICE
  ASSEMBLY
}

enum StepStatus {
  PENDING
  QUOTED
  RUNNING
  DONE
  FAILED
  APPROVED
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
}

// What a generated image is for in the character kit.
enum AssetRole {
  SHEET
  FRONT
  PROFILE
  DETAIL
}

enum UserRole {
  USER
  OWNER
}

enum SocialNetwork {
  X
  INSTAGRAM
  TIKTOK
  LINKEDIN
  THREADS
  YOUTUBE
  FACEBOOK
  BLUESKY
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
}

enum SocialPostStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
  UNKNOWN
}

enum LedgerReason {
  TOPUP
  SPEND
  REFUND
  REFERRAL
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  name        String?
  image       String?
  bio String @default("")
  defaultAspectRatio String @default("9:16") @map("default_aspect_ratio")
  defaultContentView String @default("steps") @map("default_content_view")
  avatar Bytes?
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  tokenVersion Int @default(0) @map("token_version")
  passwordHash String? @map("password_hash")
  // Set by a confirmed link/code or by a Google sign-in. A password account cannot sign in without it.
  emailVerifiedAt DateTime? @map("email_verified_at")
  // The Google account this user is bound to, so a later Google sign-in finds it even after an e-mail change.
  googleSub String? @unique @map("google_sub")
  emailTokens EmailToken[]
  // Terms/Privacy acceptance (src/lib/consent.ts). Null on accounts created before tracking began.
  consentAcceptedAt DateTime? @map("consent_accepted_at")
  consentTermsVersion String? @map("consent_terms_version")
  // Granted only by scripts/owner.ts; see src/lib/owner.ts for what it unlocks and how.
  role UserRole @default(USER)
  adminActions AdminAction[]
  createdAt   DateTime      @default(now()) @map("created_at")
  influencers Influencer[]
  assets      Asset[]
  ledger      LedgerEntry[]
  apiTokens   ApiToken[]
  templates ContentTemplate[]
  socialAccounts SocialAccount[]
  socialTenants SocialTenant[]
  socialPosts SocialPost[]
  referralCode String? @unique @map("referral_code")
  referredById String? @map("referred_by_id")
  referredBy User? @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals User[] @relation("Referrals")

  @@index([referredById])
  @@map("users")
}

// The recurring character: face reference, niche and tone. Every Content belongs to one.
model Influencer {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  niche           String
  tone            String
  persona         String    @default("")
  // What the character always looks like (hair, accessories, outfit). Feeds every prompt.
  visualSignature String    @default("") @map("visual_signature")
  faceAssetId     String?   @map("face_asset_id")
  contents        Content[]
  steps           Step[]
  assets          Asset[]
  socialAccounts  SocialAccount[]
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("influencers")
}

// One piece of content: idea -> script -> image -> video -> (voice) -> assembly.
model Content {
  id           String        @id @default(cuid())
  influencerId String        @map("influencer_id")
  influencer   Influencer    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  title        String
  motion Json?
  idea         String        @default("")
  archivedAt DateTime? @map("archived_at")
  aspectRatio  String        @default("9:16") @map("aspect_ratio")
  status       ContentStatus @default(IDEA)
  steps        Step[]
  assets       Asset[]
  socialPosts  SocialPost[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([archivedAt, updatedAt])
  @@index([influencerId, updatedAt])
  @@map("contents")
}

// One paid or free action in the pipeline. Cost is quoted before and recorded after.
model Step {
  id               String        @id @default(cuid())
  // Content steps have a content; character-kit steps (kind CHARACTER) have an influencer instead.
  contentId        String?       @map("content_id")
  content          Content?      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  influencerId     String?       @map("influencer_id")
  influencer       Influencer?   @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  kind             StepKind
  role             AssetRole?
  position         Int
  status           StepStatus    @default(PENDING)
  provider         String        @default("fal")
  // Idempotency: one operation key per intent, so a double submit never charges or sends twice.
  operationKey     String?       @unique @map("operation_key")
  // not_submitted -> submitting -> submitted | submission_unknown (never resent automatically).
  submissionState  String        @default("not_submitted") @map("submission_state")
  model            String?
  input            Json          @default("{}")
  falRequestId     String?       @unique @map("fal_request_id")
  estimatedCostBrl Decimal?      @map("estimated_cost_brl") @db.Decimal(12, 4)
  actualCostBrl    Decimal?      @map("actual_cost_brl") @db.Decimal(12, 4)
  error            String?
  assets           Asset[]
  ledger           LedgerEntry[]
  createdAt        DateTime      @default(now()) @map("created_at")
  startedAt        DateTime?     @map("started_at")
  completedAt      DateTime?     @map("completed_at")

  @@unique([contentId, position])
  @@index([influencerId, createdAt])
  @@map("steps")
}

model Asset {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencerId String?     @map("influencer_id")
  influencer   Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  contentId    String?     @map("content_id")
  content      Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)
  stepId       String?     @map("step_id")
  step         Step?       @relation(fields: [stepId], references: [id], onDelete: SetNull)
  kind         AssetKind
  role         AssetRole?
  url          String
  storageKey String? @map("storage_key")
  contentType String? @map("content_type")
  fileName String? @map("file_name")
  sizeBytes Int? @map("size_bytes")
  width        Int?
  height       Int?
  durationSec  Float?      @map("duration_sec")
  socialPosts  SocialPost[]
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([influencerId, createdAt])
  @@map("assets")
}

// Balance = sum(delta_brl). Top-ups are manual for now; spends are written when a step is confirmed.
// Personal access token for POST /api/mcp (an agent acting as the user). Only the sha256 is stored.
// Agents can read and make free drafts; paid generation stays a human confirmation in the app.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     String[]
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  usage      ApiUsage[]

  @@map("api_tokens")
}

model ApiUsage {
  id        BigInt   @id @default(autoincrement())
  tokenId   String   @map("token_id")
  token     ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tool      String
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tokenId, createdAt])
  @@map("api_usage")
}

// Landing "Pedir convite": people waiting for an access code. One row per e-mail.
model InviteRequest {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("invite_requests")
}

model LedgerEntry {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaBrl  Decimal      @map("delta_brl") @db.Decimal(12, 4)
  reason    LedgerReason
  stepId    String?      @map("step_id")
  step      Step?        @relation(fields: [stepId], references: [id], onDelete: SetNull)
  socialPostId String?     @map("social_post_id")
  socialPost SocialPost?   @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([socialPostId])
  @@map("ledger_entries")
}

// Sliding-window counters for anonymous forms (access code). Denied hits are not recorded.
model RateLimitEvent {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_events")
}

model ContentTemplate {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceContentId String @map("source_content_id")
  name String
  title String
  idea String
  script String @default("")
  aspectRatio String @map("aspect_ratio")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([userId, sourceContentId])
  @@index([userId, updatedAt])
  @@map("content_templates")
}

// Every owner action that moves money or changes privileges, written with the change itself.
// operationKey makes a repeated submit (double click, retry) a no-op instead of a second top-up.
model AdminAction {
  id String @id @default(cuid())
  actorId String? @map("actor_id")
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  targetUserId String? @map("target_user_id")
  data Json @default("{}")
  operationKey String? @unique @map("operation_key")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([targetUserId, createdAt])
  @@map("admin_actions")
}

// One-time e-mail links (and the 6-digit code for VERIFY). Only hashes are stored; issuing a new one of
// a purpose retires the older unused ones. CHANGE_EMAIL carries the address the link will switch to.
model EmailToken {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  tokenHash String @unique @map("token_hash")
  codeHash String? @map("code_hash")
  newEmail String? @map("new_email")
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, purpose])
  @@map("email_tokens")
}

// A social account a user connected, so LabIA can publish to it. Tokens are sealed by src/lib/social/crypto.ts
// and are null for aggregator (bundle.social) accounts, whose credentials live at the aggregator.
model SocialAccount {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencerId String? @map("influencer_id")
  influencer Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  network SocialNetwork
  // "x" | "bundle" | "mock"
  backend String
  // The id on the network (X user id) or at the aggregator. One LabIA owner per external account.
  providerAccountId String @map("provider_account_id")
  handle String
  displayName String? @map("display_name")
  avatarUrl String? @map("avatar_url")
  status SocialAccountStatus @default(CONNECTED)
  accessToken String? @map("access_token")
  refreshToken String? @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  scopes String?
  connectedAt DateTime @default(now()) @map("connected_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  posts SocialPost[]
  @@unique([backend, providerAccountId])
  @@index([userId, network])
  @@map("social_accounts")
}

// Aggregator-side grouping (a bundle.social team) per user and backend.
model SocialTenant {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  backend String
  externalId String @map("external_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, backend])
  @@map("social_tenants")
}

// One post to one account, now or scheduled. The estimate is reserved in the ledger when the post is created.
model SocialPost {
  id String @id @default(cuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String @map("account_id")
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contentId String? @map("content_id")
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  assetId String? @map("asset_id")
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  text String
  aiLabel Boolean @default(true) @map("ai_label")
  scheduledAt DateTime @map("scheduled_at")
  timezone String @default("America/Sao_Paulo")
  status SocialPostStatus @default(SCHEDULED)
  // One per (intent, account): a repeated submit returns the existing post and charges nothing.
  operationKey String @unique @map("operation_key")
  // Set when the status becomes PUBLISHING.
  claimedAt DateTime? @map("claimed_at")
  providerPostId String? @map("provider_post_id")
  url String?
  publishedAt DateTime? @map("published_at")
  estimatedCostBrl Decimal @map("estimated_cost_brl") @db.Decimal(12, 4)
  actualCostBrl Decimal? @map("actual_cost_brl") @db.Decimal(12, 4)
  // Controlled PT-BR copy, never raw provider text.
  error String?
  ledger LedgerEntry[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([status, scheduledAt])
  @@index([userId, createdAt])
  @@index([accountId])
  @@map("social_posts")
}

// An admin's replacement for one default prompt template (see src/lib/prompts.ts). One row per template key.
model PromptOverride {
  key       String   @id
  text      String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("prompt_overrides")
}
