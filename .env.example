# Neon: pooled URL for the app, direct (unpooled) URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Closed beta. The shared access code gates sign-in; with no code, production is closed (dev is open).
LABIA_ACCESS_CODE=
# Optional extra restriction: comma-separated e-mails allowed to sign in. Empty = anyone with the code.
ALLOWED_EMAILS=
# Comma-separated e-mails (the founders) that generate without balance. Spends are still recorded.
UNLIMITED_EMAILS=

# fal.ai (generation)
FAL_KEY=
# Optional ADMIN-scoped fal.ai key, only to show the real fal credit to UNLIMITED_EMAILS accounts.
FAL_ADMIN_KEY=

# Dev only: FAL_MOCK=1 swaps fal.ai for a fake provider (no network, no spend). Ignored in production.
FAL_MOCK=
# Optional: USD to BRL used in cost estimates (default 5.4).
USD_BRL_RATE=

# Private imported reference storage. Production requires a private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Alternatively, use a linked store and Vercel OIDC.
BLOB_STORE_ID=
# Public HTTPS origin for temporary provider-only reference links.
LABIA_PUBLIC_URL=
# Higgsfield server credential (KEY_ID:KEY_SECRET); no real requests in mock mode.
HF_CREDENTIALS=
