# Neon: pooled URL for the app, direct (unpooled) URL for migrations.
# Production uses the "LabIA Prod" project; Preview and local use "LabIA Dev". Never point Preview at Prod.
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional shared access code; set it to close the beta. E-mail + password sign-up also needs e-mail on (below).
LABIA_ACCESS_CODE=
# Optional extra restriction: comma-separated e-mails allowed to sign in. Empty = no e-mail restriction.
ALLOWED_EMAILS=
# Comma-separated e-mails (the founders) that generate without balance. Spends are still recorded.
UNLIMITED_EMAILS=

# Transactional e-mail (Resend). Production keeps e-mail OFF until BOTH are set: no password sign-up,
# no password reset, no e-mail change (sign-in keeps working). Development writes to .handoff/outbox.jsonl.
RESEND_API_KEY=
EMAIL_FROM=

# fal.ai (generation)
# Set FAL_KEY only in Vercel Production, never in Preview (the mock is ignored in production, so Preview would spend real money).
FAL_KEY=
# Optional ADMIN-scoped fal.ai key, only to show the real fal credit to UNLIMITED_EMAILS accounts.
FAL_ADMIN_KEY=

# Dev only: FAL_MOCK=1 swaps fal.ai for a fake provider (no network, no spend). Ignored in production.
FAL_MOCK=
# Optional: USD to BRL used in cost estimates (default 5.4).
USD_BRL_RATE=

# Private imported reference storage. Production requires a private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Alternatively, use a linked store and Vercel OIDC.
BLOB_STORE_ID=
# Public HTTPS origin: links in e-mails and temporary provider-only reference links. Required in production.
LABIA_PUBLIC_URL=
# Higgsfield server credential (KEY_ID:KEY_SECRET); no real requests in mock mode.
HF_CREDENTIALS=

# Social integrations
# X (Twitter) OAuth 2.0 app credentials, from the X developer portal.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Seals stored social tokens: 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
SOCIAL_TOKEN_KEY=
# bundle.social API key, used for the networks other than X.
BUNDLE_API_KEY=
# Secret that verifies bundle.social webhook calls.
BUNDLE_WEBHOOK_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/* so only the scheduler can run the dispatcher.
CRON_SECRET=
