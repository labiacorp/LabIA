DATABASE_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="server-service-role-key"
SUPABASE_ASSETS_BUCKET="assets"

FAL_KEY="fal-api-key"
USD_BRL_RATE="5.40"

DEFAULT_WORKSPACE_SLUG="felipe-labia"

# MCP remoto do LabIA. Nunca publique este valor no repositório ou em URLs.
LABIA_MCP_BEARER_TOKEN="configure-um-token-aleatorio-com-32-ou-mais-caracteres"

# O1 - conexões pessoais locais. Não usar NEXT_PUBLIC_ para estes valores.
LABIA_LOCAL_CONNECTIONS_ENABLED="true"
LABIA_LOCAL_OWNER_ID="felipe-local"

# 10-contas: e-mail que vira owner do workspace padrão no primeiro login (precisa estar confirmado).
LABIA_BOOTSTRAP_OWNER_EMAIL="felipe@exemplo.com"
# 10-contas A2: e-mails que abrem /admin/convites (separados por vírgula, sempre confirmados).
LABIA_ADMIN_EMAILS="felipe@exemplo.com"
# 10-contas: gate de cadastro. Padrão (variável ausente) = aberto: qualquer pessoa cria conta e ganha workspace
# próprio sem gasto. "invite" fecha: só entra com convite.
LABIA_SIGNUP_MODE="open"
# Auth e-mails (signup code, resend, password recovery) through Resend with LabIA's own layout.
# Both set: Supabase only mints the code/link and sends nothing. Unset: Supabase sends (local Mailpit).
# The sender domain must be verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="LabIA <noreply@your-domain>"
# 10-contas: segredo (32+ caracteres) que assina o cookie do convite durante o redirecionamento do Google.
# Sem ele o botão "Continuar com Google" não aparece. Gere com: openssl rand -base64 48
LABIA_COOKIE_SECRET="troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"
# 10-contas: Google OAuth. As chaves ficam no painel do Supabase (Authentication → Providers → Google); estas duas só
# servem para o `supabase start` local (config.toml). Passos do Google Cloud em modulos/10-contas/CONSTRUCAO.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
LABIA_LOCAL_CONNECTIONS_TOKEN="troque-por-outro-token-local-aleatorio-com-32-ou-mais-caracteres"
LABIA_PROVIDER_EXECUTOR_URL="http://127.0.0.1:4317"
LABIA_PROVIDER_EXECUTOR_PORT="4317"
LABIA_PROVIDER_EXECUTOR_TOKEN="troque-por-um-token-local-aleatorio-com-32-ou-mais-caracteres"
# Caminho absoluto fora do checkout, por exemplo C:/Users/<seu-usuario>/.labia/codex
LABIA_CODEX_HOME_ROOT="C:/Users/<seu-usuario>/.labia/codex"
LABIA_CODEX_BIN="codex"
LABIA_CODEX_VERSION="0.154.0"
LABIA_OPENAI_LOGIN_TTL_MS="600000"

# O5-P0 - heartbeat outbound do executor para uma preview/URL Vercel.
# O segredo só fica no ambiente do executor e é armazenado como hash no banco.
LABIA_CONTROL_PLANE_URL="https://labia-preview.vercel.app"
LABIA_EXECUTOR_PAIRING_ID="pairing-id-configurado-no-control-plane"
LABIA_EXECUTOR_PAIRING_SECRET="troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"
LABIA_EXECUTOR_VERSION="0.5.0"
LABIA_EXECUTOR_HEARTBEAT_TTL_MS="90000"
LABIA_EXECUTOR_HEARTBEAT_INTERVAL_MS="30000"
# Identidade apenas; authStatus/executorStatus/capabilities/models vêm do Codex App Server real.
LABIA_EXECUTOR_CONNECTIONS_JSON="[]"

# Private-beta access code asked before sign in, sign up and password recovery (/acesso).
# Required in production: with it unset the auth forms stay closed. Changing it signs every visitor out of the gate.
# Needs LABIA_COOKIE_SECRET (32+ chars) too. In local development, leaving it empty turns the gate off.
LABIA_ACCESS_CODE=
